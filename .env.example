# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird nie committet. Secrets nie in den Chat kopieren.
# Anleitung für jede Plattform: docs/SETUP.md

# Adresse der Oberfläche. Daraus entstehen die Weiterleitungs-URIs:
#   http://localhost:4321/api/oauth/<plattform>/callback
APP_BASE_URL=http://localhost:4321

# YouTube – OAuth-Client (Typ „Webanwendung“) aus deinem Google-Cloud-Projekt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram – Meta-App mit „Facebook Login for Business“
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=

# TikTok – App mit Login Kit (Desktop) und Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn – App mit „Share on LinkedIn“ und „Sign In with LinkedIn using OpenID Connect“
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional: eigener Datenordner (Standard auf dem Mac: ~/Library/Application Support/FokuspilotStudio)
# FPS_DATA_DIR=

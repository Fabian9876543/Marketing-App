# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env wird nie committet. Secrets nie in den Chat kopieren.

# Adresse der Oberfläche (so auch als OAuth-Weiterleitung eintragen)
APP_BASE_URL=http://127.0.0.1:4321

# YouTube: OAuth-Client aus deinem Google-Cloud-Projekt (Typ „Webanwendung“)
# Weiterleitungs-URI dort eintragen: http://127.0.0.1:4321/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: eigener Datenordner (Standard auf dem Mac: ~/Library/Application Support/FokuspilotStudio)
# FPS_DATA_DIR=
